      "severity": "CRITICAL",
      "complexity": "LOW",
      "changes": [
        "JWT_SECRET cleared to empty string",
        "CLOUDINARY_API_SECRET cleared",
        "RESEND_API_KEY cleared",
        "MP_ACCESS_TOKEN cleared",
        "Added security comments",
        "Instructions for rotation"
