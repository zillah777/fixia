# SECURITY: This is an example file. Copy to .env.local and fill in your values.
# NEVER commit .env with real secrets. Use platform environment variables in production.

# Database Connection
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fixia?schema=public"

# Authentication (JWT)
# SECURITY: Generate with: openssl rand -base64 32
# Must be at least 32 characters long
# Store in platform environment variables (Vercel, Netlify, AWS, etc.)
JWT_SECRET=""

# Cloudinary Configuration for file uploads
# SECURITY: Only NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME should be public
# API_KEY and API_SECRET must be kept secret - use only in server-side code
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email Service (Resend)
# SECURITY: Keep this secret
# Generate at: https://resend.com/api-keys
RESEND_API_KEY=""

# Payment Processing (MercadoPago)
# SECURITY: Keep this secret
# Get tokens from: https://www.mercadopago.com/
MP_ACCESS_TOKEN=""

# Application Configuration
# NODE_ENV: development, staging, production
NODE_ENV="development"

# Public URL (for email verification links, etc.)
# Format: http://localhost:3000 (development) or https://yourdomain.com (production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
