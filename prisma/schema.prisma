generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String               @id @default(uuid())
  email                   String               @unique
  name                    String?
  avatar                  String?
  phone                   String?              @unique
  dni                     String?              @unique
  birthdate               DateTime?
  password                String
  location                String?
  verificationToken       String?
  role                    UserRole             @default(CLIENT)
  status                  UserStatus           @default(ACTIVE)
  subscriptionId          String?
  subscriptionStatus      String?
  subscriptionPlan        String?
  subscriptionEndsAt      DateTime?
  autoRenew               Boolean              @default(true)
  subscriptionCancelledAt DateTime?
  lastRenewalAt           DateTime?
  nextBillingDate         DateTime?
  canCreateServices       Boolean              @default(false)
  listingVisible          Boolean              @default(false)
  canReceiveBookings      Boolean              @default(false)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  completedOnboarding     Boolean              @default(false)
  deletedAt               DateTime?
  favoritedBy             Favorite[]           @relation("FavoritedProfessionals")
  favorites               Favorite[]           @relation("UserFavorites")
  matchesAsClient         Match[]              @relation("ClientMatches")
  matchesAsProvider       Match[]              @relation("ProviderMatches")
  messagesSent            Message[]            @relation("MessageSender")
  notifications           Notification[]
  profile                 Profile?
  proposals               Proposal[]           @relation("ProviderProposals")
  requests                Request[]            @relation("ClientRequests")
  reviewsWritten          Review[]             @relation("ReviewAuthor")
  reviewsReceived         Review[]             @relation("ReviewTarget")
  services                Service[]            @relation("ProviderServices")
  verificationRequest     VerificationRequest?
  pushSubscriptions       PushSubscription[]

  @@index([role])
  @@index([subscriptionStatus])
  @@index([status])
  @@index([subscriptionEndsAt])
  @@index([status], map: "idx_user_status")
}

model VerificationRequest {
  id               String   @id @default(uuid())
  userId           String   @unique
  idFront          String
  idBack           String
  certificationUrl String?
  status           String   @default("PENDING")
  adminNote        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id                   String  @id @default(uuid())
  userId               String  @unique
  bio                  String?
  portfolioImages      String  @default("[]")
  locationLat          Float?
  locationLng          Float?
  ratingAvg            Float   @default(0)
  badges               String  @default("[]")
  socialLinks          String?
  trustScore           Int     @default(0)
  education            String?
  diploma              String?
  courses              String?
  certification        String?
  professionalLicense  String?
  licenseNumber        String?
  yearsExperience      Int?
  experienceDetails    String?
  experience           String?
  availability         String  @default("{}")
  workRadius           String  @default("Mi ciudad")
  workZones            String  @default("[]")
  tags                 String  @default("[]")
  notificationSettings String  @default("{}")
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id          String   @id @default(uuid())
  providerId  String
  title       String
  description String
  categoryId  String
  price       Decimal
  images      String   @default("[]")
  tags        String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  provider    User     @relation("ProviderServices", fields: [providerId], references: [id], onDelete: Cascade)
}

model Request {
  id          String     @id @default(uuid())
  clientId    String
  title       String
  description String
  categoryId  String
  location    String
  locationLat Float?
  locationLng Float?
  budget      Decimal?
  images      String     @default("[]")
  tags        String     @default("[]")
  status      String     @default("OPEN")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  match       Match?
  proposals   Proposal[]
  client      User       @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Cascade)
}

model Proposal {
  id         String   @id @default(uuid())
  requestId  String
  providerId String
  price      Decimal
  message    String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  provider   User     @relation("ProviderProposals", fields: [providerId], references: [id], onDelete: Cascade)
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, providerId])
}

model Match {
  id                         String    @id @default(uuid())
  requestId                  String    @unique
  providerId                 String
  clientId                   String
  whatsappRevealedAt         DateTime?
  isCompleted                Boolean   @default(false)
  providerApprovedCompletion Boolean?
  clientApprovedCompletion   Boolean?
  providerCompletionComment  String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  client                     User      @relation("ClientMatches", fields: [clientId], references: [id])
  provider                   User      @relation("ProviderMatches", fields: [providerId], references: [id])
  request                    Request   @relation(fields: [requestId], references: [id])
  messages                   Message[]
  reviews                    Review[]
}

model Message {
  id        String   @id @default(uuid())
  matchId   String
  senderId  String
  text      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])

  @@index([matchId])
  @@index([matchId], map: "idx_message_match_id")
}

model Review {
  id        String   @id @default(uuid())
  matchId   String
  authorId  String
  targetId  String
  score     Int
  comment   String?
  createdAt DateTime @default(now())
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  match     Match    @relation(fields: [matchId], references: [id])
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])

  @@unique([matchId, authorId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, isRead], map: "idx_notification_user_read")
}

model Favorite {
  id             String   @id @default(uuid())
  userId         String
  professionalId String
  createdAt      DateTime @default(now())
  professional   User     @relation("FavoritedProfessionals", fields: [professionalId], references: [id], onDelete: Cascade)
  user           User     @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, professionalId])
  @@index([userId])
  @@index([professionalId])
  @@index([professionalId], map: "idx_favorite_professional_id")
  @@index([userId], map: "idx_favorite_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?   @db.Uuid
  tableName   String
  action      String
  recordId    String?
  changedData Json?
  createdAt   DateTime? @default(now()) @db.Timestamp(6)

  @@index([createdAt], map: "idx_audit_log_created_at")
  @@index([tableName], map: "idx_audit_log_table_name")
  @@index([userId], map: "idx_audit_log_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model RateLimit {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?
  endpoint     String
  requestCount Int?      @default(1)
  resetAt      DateTime  @db.Timestamp(6)
  createdAt    DateTime? @default(now()) @db.Timestamp(6)

  @@index([resetAt], map: "idx_rate_limit_reset_at")
  @@index([userId, endpoint], map: "idx_rate_limit_user_endpoint")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model SessionLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String
  ipAddress      String?
  lastActivityAt DateTime? @default(now()) @db.Timestamp(6)
  expiresAt      DateTime  @db.Timestamp(6)
  isActive       Boolean?  @default(true)
  createdAt      DateTime? @default(now()) @db.Timestamp(6)

  @@index([expiresAt], map: "idx_session_log_expires_at")
  @@index([userId], map: "idx_session_log_user_id")
}

enum UserRole {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
