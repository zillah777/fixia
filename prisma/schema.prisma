// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



// ============================================================================
// ENUMS for Type Safety
// ============================================================================

enum UserRole {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

// ============================================================================
// Models
// ============================================================================

model User {
  id             String     @id @default(uuid())
  email          String     @unique
  name           String?
  avatar         String?    // Profile picture URL
  phone          String?    @unique
  dni            String?    @unique // DNI/ID Number
  birthdate      DateTime?  // Date of birth
  password       String
  location       String?    // User's city/location
  verificationToken String?
  role           UserRole   @default(CLIENT)
  status         UserStatus @default(ACTIVE)
  subscriptionId       String? // For MercadoPago subscription ID
  subscriptionStatus   String? // active, pending, cancelled
  subscriptionPlan     String? // professional_monthly
  subscriptionEndsAt   DateTime?

  // SECURITY: Subscription renewal and feature control
  autoRenew                Boolean   @default(true)
  subscriptionCancelledAt  DateTime?
  lastRenewalAt            DateTime?
  nextBillingDate          DateTime?

  // Feature control (for expired subscriptions - Airbnb/Upwork model)
  canCreateServices        Boolean   @default(false)
  listingVisible           Boolean   @default(false)
  canReceiveBookings       Boolean   @default(false)

  createdAt            DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  profile           Profile?
  services          Service[]      @relation("ProviderServices")
  requests          Request[]      @relation("ClientRequests")
  matchesAsProvider Match[]        @relation("ProviderMatches")
  matchesAsClient   Match[]        @relation("ClientMatches")
  reviewsWritten    Review[]       @relation("ReviewAuthor")
  reviewsReceived   Review[]       @relation("ReviewTarget")
  notifications     Notification[]
  favorites         Favorite[]     @relation("UserFavorites")
  favoritedBy       Favorite[]     @relation("FavoritedProfessionals")
  proposals         Proposal[]     @relation("ProviderProposals")
  verificationRequest VerificationRequest?
  messagesSent      Message[]      @relation("MessageSender")

  // Performance indexes
  @@index([role])
  @@index([subscriptionStatus])
  @@index([status])
  @@index([subscriptionEndsAt])
}

model VerificationRequest {
  id        String   @id @default(uuid())
  userId    String   @unique
  idFront   String   // URL
  idBack    String   // URL
  certificationUrl String? // URL for Professional Certification
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id              String   @id @default(uuid())
  userId          String   @unique
  bio             String?
  portfolioImages String @default("[]") // Array of Cloudinary URLs
  locationLat     Float?
  locationLng     Float?
  ratingAvg       Float    @default(0)
  badges          String @default("[]") // ["VERIFIED", "PREMIUM", "NEW"]
  socialLinks     String?  // JSON string: { instagram: "", linkedin: "", website: "" }
  trustScore      Int      @default(0) // 0-100
  
  // New Professional Fields
  certification   String?  // Certification name/details
  licenseNumber   String?  // Professional license number
  experience      String?  // Years of experience or description
  tags            String @default("[]") // Expertise tags (max 5)
  notificationSettings String @default("{}") // JSON: { newMessages: true, proposals: true, marketing: false }

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id          String   @id @default(uuid())
  providerId  String
  title       String
  description String
  categoryId  String   // Can be an Enum or a separate Category model if needed, keeping simple as String for now or ID
  price       Decimal
  images      String @default("[]") // Cloudinary URLs
  tags        String @default("[]") // Service tags
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider    User       @relation("ProviderServices", fields: [providerId], references: [id], onDelete: Cascade)
  favorites   Favorite[]
}

model Request {
  id          String        @id @default(uuid())
  clientId    String
  title       String
  description String
  categoryId  String
  location    String        // Human readable address
  locationLat Float?
  locationLng Float?

  budget      Decimal?
  images      String      @default("[]") // Cloudinary URLs
  tags        String      @default("[]") // Request tags
  status      String @default("OPEN")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client      User       @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Cascade)
  match       Match?     // 1:1 relation if only one active match allowed per request, or 1:N if history kept
  proposals   Proposal[]
}

model Proposal {
  id          String   @id @default(uuid())
  requestId   String
  providerId  String
  price       Decimal
  message     String?
  status      String   @default("PENDING") // PENDING, REJECTED, ACCEPTED
  createdAt   DateTime @default(now())

  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider    User     @relation("ProviderProposals", fields: [providerId], references: [id], onDelete: Cascade)

  // SECURITY: Prevent duplicate proposals from same provider for same request
  @@unique([requestId, providerId])
}

model Match {
  id                 String    @id @default(uuid())
  requestId          String    @unique // Ensure one match per request for simplicity in this logic
  providerId         String
  clientId           String
  whatsappRevealedAt DateTime?
  isCompleted        Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  request            Request   @relation(fields: [requestId], references: [id])
  provider           User      @relation("ProviderMatches", fields: [providerId], references: [id])
  client             User      @relation("ClientMatches", fields: [clientId], references: [id])
  reviews            Review[]
  messages           Message[]
}

model Message {
  id        String   @id @default(uuid())
  matchId   String
  senderId  String
  text      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])

  @@index([matchId])
}

model Review {
  id        String   @id @default(uuid())
  matchId   String
  authorId  String
  targetId  String
  score     Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())

  match     Match    @relation(fields: [matchId], references: [id])
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])

  // SECURITY: Prevent duplicate reviews - user can only review once per match
  @@unique([matchId, authorId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // MATCH, SYSTEM, REMINDER, REVIEW_PENDING
  message   String
  isRead    Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Performance index for querying unread notifications
  @@index([userId, isRead])
}

model Favorite {
  id              String   @id @default(uuid())
  userId          String
  professionalId  String
  createdAt       DateTime @default(now())

  user            User     @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  professional    User     @relation("FavoritedProfessionals", fields: [professionalId], references: [id], onDelete: Cascade)

  // SECURITY: User can only favorite a professional once
  @@unique([userId, professionalId])
  @@index([userId])
  @@index([professionalId])
}
