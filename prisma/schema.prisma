// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum Role {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED_PAYMENT
}

enum RequestStatus {
  OPEN
  MATCHED
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  PENDING // Offer sent
  ACCEPTED // Match active
  COMPLETED // Job done
  CANCELLED
}

// Models

model User {
  id             String     @id @default(uuid())
  email          String     @unique
  name           String?
  phone          String?    @unique
  password       String
  verificationToken String?
  role           Role       @default(CLIENT)
  status         UserStatus @default(ACTIVE)
  subscriptionId       String? // For MercadoPago subscription ID
  subscriptionStatus   String? // active, pending, cancelled
  subscriptionPlan     String? // professional_monthly
  subscriptionEndsAt   DateTime?
  createdAt            DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  profile           Profile?
  services          Service[]      @relation("ProviderServices")
  requests          Request[]      @relation("ClientRequests")
  matchesAsProvider Match[]        @relation("ProviderMatches")
  matchesAsClient   Match[]        @relation("ClientMatches")
  reviewsWritten    Review[]       @relation("ReviewAuthor")
  reviewsReceived   Review[]       @relation("ReviewTarget")
  notifications     Notification[]
  favorites         Favorite[]
  proposals         Proposal[]     @relation("ProviderProposals")
  verificationRequest VerificationRequest?
}

model VerificationRequest {
  id        String   @id @default(uuid())
  userId    String   @unique
  idFront   String   // URL
  idBack    String   // URL
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id              String   @id @default(uuid())
  userId          String   @unique
  bio             String?  @db.Text
  portfolioImages String[] // Array of Cloudinary URLs
  locationLat     Float?
  locationLng     Float?
  ratingAvg       Float    @default(0)
  badges          String[] // ["VERIFIED", "PREMIUM", "NEW"]
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id          String   @id @default(uuid())
  providerId  String
  title       String
  description String   @db.Text
  categoryId  String   // Can be an Enum or a separate Category model if needed, keeping simple as String for now or ID
  price       Decimal  @db.Decimal(10, 2)
  images      String[] // Cloudinary URLs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider    User       @relation("ProviderServices", fields: [providerId], references: [id], onDelete: Cascade)
  favorites   Favorite[]
}

model Request {
  id          String        @id @default(uuid())
  clientId    String
  title       String
  description String        @db.Text
  categoryId  String
  location    String        // Human readable address
  locationLat Float?
  locationLng Float?
  budget      Decimal?      @db.Decimal(10, 2)
  status      RequestStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client      User       @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Cascade)
  match       Match?     // 1:1 relation if only one active match allowed per request, or 1:N if history kept
  proposals   Proposal[]
}

model Proposal {
  id          String   @id @default(uuid())
  requestId   String
  providerId  String
  price       Decimal  @db.Decimal(10, 2)
  message     String?  @db.Text
  status      String   @default("PENDING") // PENDING, REJECTED, ACCEPTED
  createdAt   DateTime @default(now())

  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider    User     @relation("ProviderProposals", fields: [providerId], references: [id], onDelete: Cascade)
}

model Match {
  id                 String    @id @default(uuid())
  requestId          String    @unique // Ensure one match per request for simplicity in this logic
  providerId         String
  clientId           String
  whatsappRevealedAt DateTime?
  isCompleted        Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  request            Request   @relation(fields: [requestId], references: [id])
  provider           User      @relation("ProviderMatches", fields: [providerId], references: [id])
  client             User      @relation("ClientMatches", fields: [clientId], references: [id])
  reviews            Review[]
}

model Review {
  id        String   @id @default(uuid())
  matchId   String
  authorId  String
  targetId  String
  score     Int      // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  match     Match    @relation(fields: [matchId], references: [id])
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // MATCH, SYSTEM, REMINDER, REVIEW_PENDING
  message   String
  isRead    Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  id              String   @id @default(uuid())
  userId          String
  targetServiceId String?
  targetProfileId String?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service         Service? @relation(fields: [targetServiceId], references: [id])
  // Note: targetProfileId would likely point to a User or Profile. 
  // Assuming Profile is the target for "Professional" favorites.
  // But Profile doesn't have a back-relation defined here to keep it clean, 
  // or we can add it. For now, keeping it as an ID or relation if needed.
  // Let's add a relation to User (as Professional) for targetProfileId if strictly needed,
  // but the prompt says "Profesionales guardan otros Colegas".
}
